# =============================================================================
# apps-service — /apps/.env
# Файл интерполяции для docker compose (master, caddy) и источников переменных
# окружения master-сервиса. Скопируйте в .env и заполните:
#   cp .env.example .env && chmod 600 .env
#
# .env НЕ коммитится в git (секреты!). Пример значений ниже соответствует
# текущему прод-окружению (домен apps.openedu.urfu.ru, builtin-auth).
# Переменные, которые реально попадают в контейнеры, перечислены в
# _core/master/docker-compose.yml (environment:) и _core/caddy/docker-compose.yml.
#
# Применение изменений core (master + caddy) — штатным скриптом платформы:
#   ./restart_core.sh --build
# Не нужно вызывать docker compose вручную.
# =============================================================================

# ─── Основные ────────────────────────────────────────────────────────────────

# Окружение сборки/запуска: prod | dev.
# prod: Caddy включает auto_https (выпуск сертификатов, только :443 для
# localhost-сайтов); dev: без редиректов на HTTPS.
APP_ENV=prod

# Окружение приложения master: dev | staging | production.
# production включает строгую проверку SECRET_KEY (обязателен, >=32 символов).
#
# !!! ВНИМАНИЕ: ENV=production + пустой SECRET_KEY = master НЕ СТАРТУЕТ
# !!! (crash-loop с ошибкой валидации в docker logs). Сгенерируйте ключ ДО
# !!! запуска:  openssl rand -hex 32
ENV=production

# Основной домен платформы (UI master, auto_subdomain-база, роутинг core).
PLATFORM_DOMAIN=apps.openedu.urfu.ru

# Секретный ключ подписи cookie/sessions. ОБЯЗАТЕЛЕН при ENV=production.
# Генерация: openssl rand -hex 32
SECRET_KEY=

# CORS: список источников через запятую (для продакшена — явные домены).
ALLOWED_ORIGINS=https://apps.openedu.urfu.ru,https://help.openedu.urfu.ru,https://urfu.space

# Отладочный режим master (true — подробные логи).
DEBUG=false

# ─── Аутентификация ──────────────────────────────────────────────────────────

# builtin | keycloak. builtin — локальные пользователи в master.db (API-токен =
# числовой id пользователя, см. /apps/.platform-credentials).
AUTH_PROVIDER=builtin

# Только для AUTH_PROVIDER=keycloak:
#KEYCLOAK_SERVER_URL=https://keycloak.example.com/auth
#KEYCLOAK_REALM=platform
#KEYCLOAK_CLIENT_ID=master-service
#KEYCLOAK_CLIENT_SECRET=

# ─── Уведомления ─────────────────────────────────────────────────────────────

# Основной канал — push через Apprise (ntfy): работает из РФ, без VPN.
#NTFY_ENABLED=true
#NTFY_SERVER=https://ntfy.sh
#NTFY_TOPIC=apps-prod
#NOTIFY_URLS=ntfy://ntfy.sh/apps-prod

# Прочие Apprise-каналы (можно несколько через запятую):
#NOTIFY_URLS=ntfy://ntfy.sh/apps-prod,mailto://user:pass@mail.example.com

# Опционально: Telegram (в РФ заблокирован — нужен VPN/прокси; не основной канал)
#TELEGRAM_BOT_TOKEN=
#TELEGRAM_CHAT_IDS=[]

# ─── Бэкапы (Kopia) ──────────────────────────────────────────────────────────
# Эти же значения использует kopia-контейнер (_core/kopia/.env — держите в
# синхроне с этим блоком!). Без KOPIA_REPOSITORY и KOPIA_REPOSITORY_PASSWORD
# backup.enabled=true в манифестах сервисов работает как backup.enabled=false.

#KOPIA_REPOSITORY=/repository
#KOPIA_REPOSITORY_PASSWORD=
#KOPIA_SERVER_URL=http://kopia:51515

# Legacy (restic, не используется KopiaBackupManager):
#RESTIC_REPOSITORY=
#RESTIC_PASSWORD=

# ─── Пути и база данных (обычно не менять — это пути ВНУТРИ контейнеров) ─────
#SERVICES_PATH=/services
#CADDY_CONFIG_PATH=/caddy
#BACKUP_PATH=/backups
#DATABASE_URL=sqlite:///./master.db
#DATA_DIR=/data

# ─── Логи (LogManager) ───────────────────────────────────────────────────────
#LOG_CACHE_TTL=30
#LOG_CACHE_SIZE=5000
#LOG_ENABLE_PERSISTENCE=false
#LOG_STORAGE_PATH=./.logs_cache
