# Platform Master Service Configuration Example
# Скопируйте этот файл в .env и заполните актуальными значениями

# Database configuration
DATABASE_URL=sqlite:///./master.db

# Authentication provider: builtin | keycloak
AUTH_PROVIDER=builtin

# Application environment: dev | staging | production
ENV=dev

# Secret key for cookie signing (REQUIRED, min 32 chars)
# Generate with: openssl rand -hex 32
SECRET_KEY=

# Platform domain (used for Caddy routing)
PLATFORM_DOMAIN=localhost

# Paths
SERVICES_PATH=/services
CADDY_CONFIG_PATH=/caddy
BACKUP_PATH=/backups

# Keycloak settings (только если AUTH_PROVIDER=keycloak)
KEYCLOAK_SERVER_URL=http://keycloak:8080/auth
KEYCLOAK_REALM=platform
KEYCLOAK_CLIENT_ID=master-service

# Notifications (optional). Primary channel: NOTIFY_URLS (Apprise/ntfy).
#NOTIFY_URLS=ntfy://ntfy.sh/your-topic
#NTFY_ENABLED=true
#NTFY_SERVER=https://ntfy.sh
#NTFY_TOPIC=your-topic

# Telegram (optional, blocked in RU — не основной канал)
#TELEGRAM_BOT_TOKEN=
#TELEGRAM_CHAT_IDS=[]

# LogManager settings
LOG_CACHE_TTL=30
LOG_CACHE_SIZE=5000
LOG_ENABLE_PERSISTENCE=false
DATA_DIR=/data
